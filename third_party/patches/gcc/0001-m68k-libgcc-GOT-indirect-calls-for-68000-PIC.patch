m68k libgcc: use GOT-indirect calls for 68000 PIC

The 68000 has no bsr.l instruction (that's 68020+), so jbsr in PIC
mode emits a 16-bit bsr with R_68K_PC16 relocations.  This overflows
when libgcc functions are linked into binaries with >32KB of text.

Fix PICCALL/PICJUMP macros in both the uClinux -msep-data and Linux
code paths to use GOT-indirect calls (via a5 from -msep-data) on
68000.  This matches the approach used by the __ID_SHARED_LIBRARY__
code path.

--- a/libgcc/config/m68k/lb1sf68.S
+++ b/libgcc/config/m68k/lb1sf68.S
@@ -163,6 +163,11 @@
 #if defined (__mcoldfire__) && !defined (__mcfisab__) && !defined (__mcfisac__)
 	lea	\addr-.-8,a0
 	jsr	pc@(a0)
+#elif defined(__mc68000__) && !defined(__mc68020__)
+	/* 68000 has no bsr.l; use GOT-indirect call (a5 = GOT base
+	   from -msep-data) to avoid 16-bit PC-relative overflow.  */
+	movel	\addr@GOT(a5), a0
+	jsr	a0@
 #else
 	jbsr	\addr
 #endif
@@ -175,6 +180,9 @@
 #if defined (__mcoldfire__) && !defined (__mcfisab__)
 	lea	\addr-.-8,a0
 	jmp	pc@(a0)
+#elif defined(__mc68000__) && !defined(__mc68020__)
+	movel	\addr@GOT(a5), a0
+	jmp	a0@
 #else
 	bra	\addr
 #endif
@@ -202,6 +210,9 @@
 #if defined (__mcoldfire__) && !defined (__mcfisab__) && !defined (__mcfisac__)
 	lea	\addr-.-8,a0
 	jsr	pc@(a0)
+#elif defined(__mc68000__) && !defined(__mc68020__)
+	movel	\addr@GOT(a5), a0
+	jsr	a0@
 #else
 	jbsr	\addr
 #endif
@@ -214,6 +225,9 @@
 #if defined (__mcoldfire__) && !defined (__mcfisab__)
 	lea	\addr-.-8,a0
 	jmp	pc@(a0)
+#elif defined(__mc68000__) && !defined(__mc68020__)
+	movel	\addr@GOT(a5), a0
+	jmp	a0@
 #else
 	bra	\addr
 #endif
