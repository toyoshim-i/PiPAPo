/*
 * PPAP syscall numbers for musl libc (m68k)
 *
 * Maps Linux syscall names to PPAP 16-bit grouped numbering.
 * Syscalls not implemented by PPAP use 0xF0xx numbers and will return -ENOSYS.
 *
 * PPAP groups:
 *   0x00xx  Process       0x05xx  Time
 *   0x01xx  I/O           0x06xx  Signals
 *   0x02xx  FS paths      0x07xx  Poll
 *   0x03xx  FS extended   0x08xx  User/group
 *   0x04xx  Memory        0x09xx  Mount
 *                          0x0Axx  Misc
 */

/* Group 0x00: Process lifecycle */
#define __NR_exit		0x0000
#define __NR_exit_group		0x0001
#define __NR_vfork		0x0002
#define __NR_execve		0x0003
#define __NR_waitpid		0x0004
#define __NR_wait4		0x0005
#define __NR_getpid		0x0006
#define __NR_uname		0x0007
#define __NR_getppid		0x0008
#define __NR_setpgid		0x0009
#define __NR_getpgid		0x000A
#define __NR_setsid		0x000B
#define __NR_clone		0x000C
#define __NR_set_tid_address	0x000D
#define __NR_fork		0x000E

/* Group 0x01: I/O */
#define __NR_read		0x0100
#define __NR_write		0x0101
#define __NR_open		0x0102
#define __NR_close		0x0103
#define __NR_dup		0x0104
#define __NR_dup2		0x0105
#define __NR_pipe		0x0106
#define __NR_ioctl		0x0107
#define __NR_fcntl		0x0108
#define __NR_fcntl64		0x0108
#define __NR_readv		0x0109
#define __NR_writev		0x010A
#define __NR_lseek		0x010B

/* Group 0x02: File system - paths */
#define __NR_stat		0x0200
#define __NR_stat64		0x0200
#define __NR_fstat		0x0201
#define __NR_fstat64		0x0201
#define __NR_access		0x0202
#define __NR_mkdir		0x0203
#define __NR_rmdir		0x0204
#define __NR_unlink		0x0205
#define __NR_rename		0x0206
#define __NR_link		0x0207
#define __NR_symlink		0x0208
#define __NR_readlink		0x0209
#define __NR_chdir		0x020A
#define __NR_fchdir		0x020B
#define __NR_getcwd		0x020C
#define __NR_chmod		0x020D
#define __NR_chown		0x020E
#define __NR_chown32		0x020E
#define __NR_lstat		0x020F
#define __NR_lstat64		0x020F
#define __NR_mknod		0x0210
#define __NR_umask		0x0211
#define __NR_getdents64		0x0212
#define __NR_fchmod		0x0213
#define __NR_fchown		0x0214
#define __NR_fchown32		0x0214

/* Group 0x03: File system - extended */
#define __NR_openat		0x0300
#define __NR_mkdirat		0x0301
#define __NR_unlinkat		0x0302
#define __NR_renameat		0x0303
#define __NR_fstatat64		0x0304
#define __NR_readlinkat		0x0305
#define __NR_fchmodat		0x0306
#define __NR_fchownat		0x0307
#define __NR_linkat		0x0308
#define __NR_symlinkat		0x0309
#define __NR_mknodat		0x030A
#define __NR_faccessat		0x030B
#define __NR_utimensat		0x030C
#define __NR_renameat2		0x030D
#define __NR_statx		0x030E

/* Group 0x04: Memory management */
#define __NR_brk		0x0400
#define __NR_mmap2		0x0401
#define __NR_munmap		0x0402
#define __NR_mremap		0x0403
