# PicoPiAndPortable — busybox config fragment
# Applied on top of allnoconfig via build_busybox.sh
#
# Single busybox binary containing all applets plus hush shell.
# The default /bin/sh is PPAP's own push shell; hush is available
# as /bin/hush for bash-compatible scripting.
#
# Key design choices:
#   - NOMMU mode (no fork, vfork-only)
#   - PIE linking with musl libc (R_ARM_RELATIVE relocations for XIP)
#   - Coreutils + editors + filesystem + shell
#   - No Linux-specific features (sendfile, utmp, syslog)

# -- Platform -----------------------------------------------------------------
# CONFIG_STATIC is NOT set — we use -pie to get .rel.dyn relocations.
# The exec.c loader needs these to fix up function-pointer arrays
# (e.g. applet_main[]) whose entries are raw link-time addresses.
CONFIG_NOMMU=y

# -- Size optimization --------------------------------------------------------
CONFIG_LFS=y

# -- File operations ----------------------------------------------------------
# CONFIG_LS is not set (using native PPAP ls)
# CONFIG_CAT is not set (using native PPAP cat)
CONFIG_CP=y
CONFIG_MV=y
CONFIG_RM=y
CONFIG_MKDIR=y
CONFIG_RMDIR=y
CONFIG_LN=y
CONFIG_CHMOD=y

# -- Text processing ----------------------------------------------------------
# CONFIG_ECHO is not set (push built-in)
CONFIG_PRINTF=y
CONFIG_GREP=y
CONFIG_HEAD=y
CONFIG_TAIL=y
CONFIG_WC=y
CONFIG_SORT=y
CONFIG_SED=y

# -- Process management -------------------------------------------------------
CONFIG_KILL=y
# CONFIG_SLEEP is not set (using native PPAP sleep)
# CONFIG_PS is not set (using native PPAP ps)
# CONFIG_TOP is not set (using native PPAP top)
# CONFIG_FEATURE_TOP_INTERACTIVE is not set
# CONFIG_FEATURE_TOP_CPU_USAGE_PERCENTAGE is not set
# CONFIG_FEATURE_TOP_CPU_GLOBAL_PERCENTS is not set

# -- Filesystem utilities -----------------------------------------------------
CONFIG_MOUNT=y
CONFIG_UMOUNT=y
# CONFIG_DF is not set (using native PPAP df)

# -- Editor -------------------------------------------------------------------
# vi disabled — replaced by pi (PiPAPo Editor)
# CONFIG_VI is not set
# CONFIG_FEATURE_VI_COLON is not set
# CONFIG_FEATURE_VI_SEARCH is not set

# -- System -------------------------------------------------------------------
# CONFIG_UNAME is not set (using native PPAP uname)

# -- Shell (hush) -------------------------------------------------------------
CONFIG_HUSH=y
CONFIG_SH_IS_HUSH=y
CONFIG_HUSH_BASH_COMPAT=y
CONFIG_HUSH_HELP=y
CONFIG_HUSH_INTERACTIVE=y
CONFIG_HUSH_EXPORT=y
CONFIG_HUSH_READONLY=y
CONFIG_HUSH_TICK=y
CONFIG_HUSH_IF=y
CONFIG_HUSH_LOOPS=y
CONFIG_HUSH_CASE=y
CONFIG_HUSH_FUNCTIONS=y
CONFIG_HUSH_LOCAL=y

