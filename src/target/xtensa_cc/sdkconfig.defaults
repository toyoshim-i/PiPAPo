# PPAP sdkconfig overrides for xtensa-cc target
#
# PPAP replaces FreeRTOS with its own scheduler, so ESP-IDF's
# watchdog timers (which expect FreeRTOS tick callbacks) must be disabled.

# Disable interrupt watchdog (fires when ISRs block too long)
CONFIG_ESP_INT_WDT=n

# Disable task watchdog (fires when FreeRTOS tasks don't yield)
CONFIG_ESP_TASK_WDT_EN=n

# Run single-core: PPAP doesn't use Core 1 yet, and FreeRTOS tasks
# on Core 1 (idle, timer, IPC) interfere with PPAP's scheduler/memory.
CONFIG_FREERTOS_UNICORE=y

# Flash size: CardComputer has 8 MB flash
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y

# Enable managed PSRAM for PPAP-owned external execution arenas.
# XT-2.5 reserves external memory via heap_caps first; user-image placement
# into those arenas is a later loader step.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_CAPS_ALLOC=y

# Allow PSRAM to be absent on hardware variants without external RAM.
# With XIP-from-PSRAM mode, ESP-IDF hard-aborts if PSRAM detection fails
# (cannot continue without the XIP mapping). Without this flag, PSRAM
# detection failure is a soft error and startup continues normally.
# PPAP kernel code checks esp_psram_get_size()==0 and disables external
# arenas at runtime without this needing a boot-time abort.
CONFIG_SPIRAM_IGNORE_NOTFOUND=y

# Disable memory protection so IRAM can be used as executable heap.
# PPAP allocates user-process code in IRAM via heap_caps_malloc(MALLOC_CAP_EXEC).
CONFIG_ESP_SYSTEM_MEMPROT_FEATURE=n
